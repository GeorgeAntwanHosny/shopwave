# ── App ──────────────────────────────────────────────────────────────
APP_NAME=ShopWave
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Database (Postgres container) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shopwave
DB_USERNAME=shopwave
DB_PASSWORD=secret

# ── Redis container ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache / Session / Queue ──────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
MAIL_MAILER=log

# ── Sanctum ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET=sk_test_51U8l5zIAL496Gox09zFq9qMDhTxEUWzDxRrFjlQtDHOnRd38H0hMzxAKl4WS3soqYGXVNHd43SoyXcrAYF1x3Wfp00g9vqVwAr
STRIPE_WEBHOOK_SECRET=whsec_d64b520ba3c0b3e56986e9c7c8e2127336c13da8a39a9703033909d1ec709b0a
STRIPE_PAYMENT_WEBHOOK_SECRET=whsec_d64b520ba3c0b3e56986e9c7c8e2127336c13da8a39a9703033909d1ec709b0a
PLATFORM_COMMISSION_PERCENT=10

# ── App-specific config ────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5

# ── Laravel Reverb — server-side credentials ─────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shopwave
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# What Laravel's OWN server-side broadcasting client connects to (API
# container → Reverb container, inside the Docker network) — this is
# deliberately the Docker service name, NOT localhost. See the frontend's
# NEXT_PUBLIC_REVERB_HOST below for the browser-facing counterpart.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Frontend (Next.js) — must be the browser's exposed host ports,
#    never a Docker-internal service name (browsers can't resolve those) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51U8l5zIAL496Gox0servnl8Ety0zwBjYrccjRTeesSs2dsJfKbppwDW6f6XckOi1lDrMpmdwFNGLcipA1r0aTQWQ00slOGRKJZ