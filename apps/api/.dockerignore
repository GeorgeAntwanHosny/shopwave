# Docker Build Context Excludes

# 1. Symlinks & Volatile Storage (Prevents build failures)
public/storage
storage/app/public/*
!storage/app/public/.gitkeep
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# 2. Dependencies & Build Artifacts
vendor/
node_modules/

# 3. Version Control & Environment
.git/
.gitignore
.env
.env.*
!.env.example

# 4. Testing & Tooling Caches
tests/
.phpunit.result.cache
.vscode/
.idea/
# Prevent cached configs from being baked into the image
bootstrap/cache/*.php
!bootstrap/cache/.gitkeep
