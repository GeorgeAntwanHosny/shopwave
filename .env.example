# ── App ──────────────────────────────────────────────────────────────
APP_NAME=ShopWave
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Database (Postgres container) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=shopwave
DB_USERNAME=shopwave
DB_PASSWORD=secret

# ── Redis container ─────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache / Session / Queue ──────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
MAIL_MAILER=log

# ── Sanctum ──────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Stripe — replace with your own free test-mode keys from
#    https://dashboard.stripe.com/test/apikeys ────────────────────────
STRIPE_SECRET=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_connect_webhook_secret_here
STRIPE_PAYMENT_WEBHOOK_SECRET=whsec_your_payment_webhook_secret_here
PLATFORM_COMMISSION_PERCENT=10

# ── App-specific config ────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5

# ── Laravel Reverb — server-side credentials ─────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=shopwave
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# What Laravel's OWN server-side broadcasting client connects to (API
# container → Reverb container, inside the Docker network) — deliberately
# the Docker service name, NOT localhost. See NEXT_PUBLIC_REVERB_HOST
# below for the browser-facing counterpart.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Frontend (Next.js) — must be the browser's exposed host ports,
#    never a Docker-internal service name (browsers can't resolve those) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_APP_KEY=local-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here